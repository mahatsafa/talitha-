---
import JudulSection from './JudulSection.astro';
import { ADAT } from '../data/konten';
---

<section id="adat" class="scroll-mt-28">
  <JudulSection kecil="Identitas Visual & Arsitektur" judul="Rumah, Pakaian & Senjata Adat" />

  <div class="grid lg:grid-cols-3 gap-8">
    {
      ADAT.map((a) => (
        <article class:list={['reveal-init', a.animasi, 'gold-card p-8 rounded-2xl flex flex-col']}>
          <div class="w-14 h-14 rounded-2xl bg-gold/10 border border-gold flex items-center justify-center text-gold text-2xl mb-6">
            <i class={`fa-solid ${a.ikon}`} aria-hidden="true" />
          </div>
          <h3 class="font-serif text-2xl font-bold text-gold mb-2">{a.nama}</h3>
          <p class="text-xs font-aksara text-amber-300 mb-4" lang="jv">{a.aksara}</p>
          <img
            src={a.gambar}
            alt={a.nama}
            loading="lazy"
            decoding="async"
            class="w-full h-44 object-cover rounded-xl mb-4 border border-gold/20"
            onerror={`this.onerror=null;this.src='${a.cadangan}'`}
          />
          <p class="text-amber-100/80 text-sm leading-relaxed" set:html={a.deskripsi} />
        </article>
      ))
    }
  </div>
</section>
