---
import JudulSection from './JudulSection.astro';
import { WILAYAH, ZONA } from '../data/wilayah';
import peta from '../data/peta-jatim.json';

const warnaZona = Object.fromEntries(ZONA.map((z) => [z.id, z.warna]));
const infoKode = new Map(WILAYAH.map((w) => [w.kode, w]));
const [, , lebar, tinggi] = peta.viewBox.split(' ').map(Number);
const pad = 46;
---

<section id="peta" class="scroll-mt-28">
  <JudulSection
    kecil="Peta Geografis & Kebudayaan"
    judul="Peta Jawa Timur (38 Daerah)"
    sub="Klik wilayah di peta atau cari Kabupaten/Kota untuk melihat info kebudayaan khasnya"
    serif={false}
  />

  <div class="max-w-xl mx-auto mb-6 relative">
    <label for="mapSearchInput" class="sr-only">Cari kabupaten atau kota</label>
    <input
      type="search"
      id="mapSearchInput"
      maxlength="60"
      autocomplete="off"
      placeholder="Cari daerah, kesenian, atau kuliner (contoh: Malang, Reog, Rawon)..."
      class="w-full pl-6 pr-14 py-4 rounded-full bg-charcoal/90 border border-gold/40 text-amber-100 placeholder-amber-200/40 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/30 shadow-xl transition"
    />
    <i class="fa-solid fa-magnifying-glass absolute right-6 top-1/2 -translate-y-1/2 text-gold text-lg" aria-hidden="true"></i>
  </div>

  <div class="flex flex-wrap justify-center gap-2 mb-10" role="group" aria-label="Filter zona budaya">
    <button data-zona="semua" aria-pressed="true" class="zone-btn px-4 py-2 rounded-full border border-gold/40 font-bold text-xs uppercase transition">
      Semua Zona
    </button>
    {
      ZONA.map((z) => (
        <button data-zona={z.id} aria-pressed="false" class="zone-btn px-4 py-2 rounded-full border border-gold/40 font-bold text-xs uppercase transition inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full" style={`background:${z.warna}`} aria-hidden="true" />
          {z.label}
        </button>
      ))
    }
  </div>

  <div class="grid lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-7 gold-card diam p-4 sm:p-6 rounded-2xl relative">
      <h3 class="font-serif text-xl font-bold text-gold mb-1 flex items-center gap-2">
        <i class="fa-solid fa-map" aria-hidden="true"></i> Peta Kabupaten/Kota Jawa Timur
      </h3>
      <p class="text-xs text-amber-200/60 mb-4">
        Dikelilingi Laut Jawa (Utara), Samudra Hindia (Selatan), Jawa Tengah (Barat), &amp; Selat Bali (Timur)
      </p>

      <div id="petaBungkus" class="relative rounded-xl border border-gold/20 bg-obsidian/60 overflow-hidden">
        <svg
          id="petaSvg"
          viewBox={`${-pad} ${-pad} ${lebar + pad * 2} ${tinggi + pad * 2}`}
          class="w-full h-auto block"
          role="group"
          aria-label="Peta interaktif 38 kabupaten dan kota di Jawa Timur"
        >
          <defs>
            <pattern id="ombak" width="24" height="12" patternUnits="userSpaceOnUse">
              <path d="M0 6 Q6 0 12 6 T24 6" fill="none" stroke="#d4af37" stroke-opacity="0.07" stroke-width="1" />
            </pattern>
          </defs>
          <rect x={-pad} y={-pad} width={lebar + pad * 2} height={tinggi + pad * 2} fill="url(#ombak)" />

          <g font-family="Plus Jakarta Sans, sans-serif" font-weight="700" fill="#d4af37" fill-opacity="0.45" letter-spacing="6" font-size="16" text-anchor="middle">
            <text x={lebar * 0.42} y={-pad / 2 + 8}>LAUT JAWA</text>
            <text x={lebar * 0.55} y={tinggi + pad / 2 + 4}>SAMUDRA HINDIA</text>
            <text x={-pad / 2 + 6} y={tinggi * 0.45} transform={`rotate(-90 ${-pad / 2 + 6} ${tinggi * 0.45})`}>JAWA TENGAH</text>
            <text x={lebar + pad / 2 - 4} y={tinggi * 0.3} transform={`rotate(90 ${lebar + pad / 2 - 4} ${tinggi * 0.3})`}>SELAT BALI</text>
          </g>

          <g transform={`translate(${lebar - 40} ${tinggi - 40})`} fill="none" stroke="#d4af37" stroke-opacity="0.5" aria-hidden="true">
            <circle r="22" />
            <path d="M0 -30 L6 0 L0 30 L-6 0 Z" fill="#d4af37" fill-opacity="0.35" />
            <text y="-36" text-anchor="middle" font-size="12" fill="#d4af37" stroke="none" font-weight="700">U</text>
          </g>

          <g id="petaWilayah">
            {
              peta.wilayah.map((p) => {
                const w = infoKode.get(p.kode)!;
                return (
                  <path
                    class="peta-wilayah"
                    d={p.d}
                    fill={warnaZona[w.zona]}
                    data-kode={p.kode}
                    tabindex="0"
                    role="button"
                    aria-label={w.nama}
                  />
                );
              })
            }
          </g>

          <g aria-hidden="true">
            <circle cx={peta.wilayah.find((p) => p.kode === '3578')!.cx} cy={peta.wilayah.find((p) => p.kode === '3578')!.cy} r="5" fill="#0a0806" stroke="#ffd700" stroke-width="2" />
          </g>
        </svg>

        <div id="petaTooltip" class="pointer-events-none absolute z-10 hidden px-3 py-1.5 rounded-lg bg-obsidian/95 border border-gold/60 text-xs text-gold font-semibold whitespace-nowrap shadow-lg"></div>
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4 text-[11px] text-amber-200/70">
        {
          ZONA.filter((z) => z.id !== 'Tengger').map((z) => (
            <span class="inline-flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-sm" style={`background:${z.warna}`} aria-hidden="true" />
              {z.label}
            </span>
          ))
        }
        <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full border-2 border-gold-glow bg-obsidian" aria-hidden="true"></span> Ibu kota provinsi</span>
      </div>
      <p class="text-[10px] text-amber-200/40 mt-2">
        Batas wilayah disederhanakan; pulau kecil (Bawean, Kangean, dsb.) tidak ditampilkan. Sumber geometri:
        <a class="underline hover:text-gold" href="https://github.com/eppofahmi/geojson-indonesia" target="_blank" rel="noopener">eppofahmi/geojson-indonesia</a>.
      </p>
    </div>

    <div class="lg:col-span-5">
      <p id="jumlahWilayah" class="text-xs text-amber-200/60 mb-3" aria-live="polite">Menampilkan 38 dari 38 daerah</p>
      <ul class="h-[420px] lg:h-[560px] overflow-y-auto pr-2 space-y-3" id="regionListContainer">
        {
          WILAYAH.map((w) => (
            <li data-kode={w.kode}>
              <button class="kartu-wilayah gold-card w-full text-left p-4 rounded-xl hover:border-gold transition flex items-center justify-between gap-3" data-kode={w.kode}>
                <span class="flex items-center gap-3 min-w-0">
                  <span class="w-2.5 h-10 rounded-full shrink-0" style={`background:${warnaZona[w.zona]}`} aria-hidden="true" />
                  <span class="min-w-0">
                    <span class="font-bold text-gold text-base block truncate">{w.nama}</span>
                    <span class="text-xs text-amber-200/60 font-serif block truncate">
                      Zona: {w.zona}{w.tengger && ' · Tengger'} | Pusat: {w.pusat}
                    </span>
                  </span>
                </span>
                <i class="fa-solid fa-chevron-right text-gold/50 text-sm" aria-hidden="true" />
              </button>
            </li>
          ))
        }
        <li id="wilayahKosong" class="hidden text-center text-sm text-amber-200/60 py-10">
          <i class="fa-solid fa-magnifying-glass-location text-3xl text-gold/40 mb-3 block" aria-hidden="true"></i>
          Tidak ada daerah yang cocok.
        </li>
      </ul>
    </div>
  </div>

  <dialog id="regionModal" class="modal-emas" aria-labelledby="modalNama">
    <div class="gold-card diam p-8 rounded-2xl relative">
      <button data-tutup class="absolute top-4 right-4 w-9 h-9 rounded-full text-amber-300 hover:text-gold hover:bg-gold/10 text-xl" aria-label="Tutup">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <div class="text-center">
        <span id="modalZona" class="text-xs font-bold uppercase tracking-widest text-gold border border-gold/40 px-3 py-1 rounded-full bg-gold/10 inline-block mb-3"></span>
        <h3 id="modalNama" class="font-cinzel text-2xl sm:text-3xl font-bold text-gold mb-1"></h3>
        <p class="text-xs text-amber-200/70 mb-6">
          <i class="fa-solid fa-location-dot text-amber-400 mr-1" aria-hidden="true"></i> Ibu Kota / Pusat: <span id="modalPusat"></span>
        </p>
        <div class="space-y-4 text-left border-t border-gold/20 pt-4">
          <div class="p-3 bg-obsidian rounded-xl border border-gold/20">
            <span class="text-xs font-bold text-gold uppercase block mb-1"><i class="fa-solid fa-masks-theater text-amber-400 mr-1" aria-hidden="true"></i> Kesenian khas:</span>
            <p id="modalSeni" class="text-sm text-amber-100"></p>
          </div>
          <div class="p-3 bg-obsidian rounded-xl border border-gold/20">
            <span class="text-xs font-bold text-gold uppercase block mb-1"><i class="fa-solid fa-utensils text-amber-400 mr-1" aria-hidden="true"></i> Kuliner khas:</span>
            <p id="modalKuliner" class="text-sm text-amber-100"></p>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</section>

<style>
  .zone-btn {
    background: var(--color-charcoal);
    color: var(--color-gold);
  }
  .zone-btn:hover {
    background: color-mix(in srgb, var(--color-gold) 20%, var(--color-charcoal));
  }
  .zone-btn[aria-pressed='true'] {
    background: var(--color-gold);
    color: var(--color-obsidian);
  }
</style>

<script>
  import { WILAYAH } from '../data/wilayah';
  import { saringWilayah, cocokZona, type Zona } from '../lib/wilayah';
  import { mainkanNada } from '../scripts/audio';

  const perKode = new Map(WILAYAH.map((w) => [w.kode, w]));
  const input = document.getElementById('mapSearchInput') as HTMLInputElement;
  const tombolZona = [...document.querySelectorAll<HTMLButtonElement>('.zone-btn')];
  const jalur = [...document.querySelectorAll<SVGPathElement>('.peta-wilayah')];
  const item = [...document.querySelectorAll<HTMLLIElement>('#regionListContainer li[data-kode]')];
  const kosong = document.getElementById('wilayahKosong')!;
  const jumlah = document.getElementById('jumlahWilayah')!;
  const tooltip = document.getElementById('petaTooltip')!;
  const bungkus = document.getElementById('petaBungkus')!;
  const modal = document.getElementById('regionModal') as HTMLDialogElement;

  let zona: Zona | 'semua' = 'semua';

  function terapkan() {
    const lolos = new Set(saringWilayah(WILAYAH, input.value, zona).map((w) => w.kode));
    for (const p of jalur) {
      const kode = p.dataset.kode!;
      p.classList.toggle('redup', !lolos.has(kode));
      p.classList.toggle('tengger-aktif', zona === 'Tengger' && cocokZona(perKode.get(kode)!, 'Tengger'));
    }
    for (const li of item) li.hidden = !lolos.has(li.dataset.kode!);
    kosong.classList.toggle('hidden', lolos.size > 0);
    jumlah.textContent = `Menampilkan ${lolos.size} dari ${WILAYAH.length} daerah`;
  }

  input.addEventListener('input', terapkan);
  for (const b of tombolZona) {
    b.addEventListener('click', () => {
      zona = b.dataset.zona as Zona | 'semua';
      for (const t of tombolZona) t.setAttribute('aria-pressed', String(t === b));
      terapkan();
    });
  }

  function bukaModal(kode: string) {
    const w = perKode.get(kode);
    if (!w) return;
    document.getElementById('modalZona')!.textContent = `Wilayah Sub-Budaya ${w.zona}${w.tengger ? ' · Tengger' : ''}`;
    document.getElementById('modalNama')!.textContent = w.nama;
    document.getElementById('modalPusat')!.textContent = w.pusat;
    document.getElementById('modalSeni')!.textContent = w.seni;
    document.getElementById('modalKuliner')!.textContent = w.kuliner;
    mainkanNada(5);
    modal.showModal();
  }

  modal.addEventListener('click', (e) => {
    // klik di backdrop (di luar kartu) atau tombol tutup
    if (e.target === modal || (e.target as Element).closest('[data-tutup]')) modal.close();
  });

  function sorot(kode: string | null) {
    for (const p of jalur) p.classList.toggle('sorot', p.dataset.kode === kode);
  }

  for (const p of jalur) {
    const kode = p.dataset.kode!;
    p.addEventListener('click', () => bukaModal(kode));
    p.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        bukaModal(kode);
      }
    });
    p.addEventListener('pointerenter', () => {
      tooltip.textContent = perKode.get(kode)!.nama;
      tooltip.classList.remove('hidden');
      // bawa ke depan supaya garis sorot tidak tertutup tetangga; hanya kalau
      // belum paling depan, karena memindah node di tengah klik membatalkan klik
      if (p.nextElementSibling) p.parentNode!.appendChild(p);
    });
    p.addEventListener('pointerleave', () => tooltip.classList.add('hidden'));
  }

  bungkus.addEventListener('pointermove', (e) => {
    if (tooltip.classList.contains('hidden')) return;
    const r = bungkus.getBoundingClientRect();
    const x = Math.min(e.clientX - r.left + 14, r.width - tooltip.offsetWidth - 4);
    tooltip.style.left = `${Math.max(4, x)}px`;
    tooltip.style.top = `${e.clientY - r.top + 14}px`;
  });

  for (const li of item) {
    const kode = li.dataset.kode!;
    const tombol = li.querySelector('button')!;
    tombol.addEventListener('click', () => bukaModal(kode));
    tombol.addEventListener('pointerenter', () => sorot(kode));
    tombol.addEventListener('pointerleave', () => sorot(null));
    tombol.addEventListener('focus', () => sorot(kode));
    tombol.addEventListener('blur', () => sorot(null));
  }

  terapkan();
</script>
