---
import JudulSection from './JudulSection.astro';
import { KESENIAN } from '../data/konten';
---

<section id="kesenian" class="scroll-mt-28">
  <JudulSection
    kecil="Atraksi Magis & Pertunjukan"
    judul="Kesenian Tradisional Jawa Timur"
    sub="Perpaduan antara keberanian, keindahan tarian, dan kisah sejarah rakyat"
  />

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      KESENIAN.map((k) => (
        <article class:list={['reveal-init', k.animasi, 'gold-card rounded-2xl overflow-hidden flex flex-col group', 'lebar' in k && 'md:col-span-2 lg:col-span-2']}>
          <div class="relative h-60 overflow-hidden">
            <img
              src={k.gambar}
              alt={k.nama}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
              onerror={`this.onerror=null;this.src='${k.cadangan}'`}
            />
            <div class="absolute inset-0 bg-linear-to-t from-charcoal/80 via-transparent to-transparent" />
            <div class="absolute top-3 right-3 bg-obsidian/80 border border-gold text-gold text-xs px-3 py-1 rounded-full font-semibold">{k.daerah}</div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-2xl font-bold text-gold mb-2">{k.nama}</h3>
              <p class="text-xs font-aksara text-amber-300 mb-3" lang="jv">{k.aksara}</p>
              <p class="text-amber-100/80 text-sm leading-relaxed mb-4" set:html={k.deskripsi} />
            </div>
            <div class="pt-4 border-t border-gold/10 text-xs text-gold/80 flex items-center justify-between gap-2">
              <span><i class={`fa-solid ${k.ikon} mr-1`} aria-hidden="true" /> {k.label}</span>
              <span>{k.catatan}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
