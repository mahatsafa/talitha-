---
const tautan = [
  { href: '#wawasan', label: 'Wawasan' },
  { href: '#kesenian', label: 'Kesenian' },
  { href: '#adat', label: 'Rumah & Pakaian' },
  { href: '#peta', label: 'Peta 38 Daerah' },
  { href: '#kuliner', label: 'Kuliner' },
  { href: '#interaktif', label: 'Gamelan & Fitur' },
];
---

<div id="progresScroll" class="fixed top-0 left-0 h-[3px] w-full origin-left scale-x-0 bg-linear-to-r from-gold-dark via-gold to-gold-glow z-50 pointer-events-none" aria-hidden="true"></div>

<nav class="sticky top-0 z-40 bg-obsidian/90 backdrop-blur-md border-b border-gold/20 shadow-lg" aria-label="Navigasi utama">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="#" class="flex items-center gap-3">
        <i class="fa-solid fa-monument text-2xl text-gold" aria-hidden="true"></i>
        <div>
          <span class="font-cinzel font-bold text-base sm:text-lg text-gold block leading-tight">WAWASAN NUSANTARA</span>
          <span class="text-[10px] sm:text-xs text-amber-200/70 uppercase tracking-wider block">Warisan Budaya Jawa Timur</span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-6 text-sm font-medium">
        {tautan.map((t) => <a href={t.href} data-nav class="relative py-1 hover:text-gold transition">{t.label}</a>)}
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <button id="soundToggleBtn" class="w-10 h-10 rounded-full border border-gold/40 text-gold hover:bg-gold/10 transition" aria-pressed="true" aria-label="Matikan suara">
          <i id="soundIcon" class="fa-solid fa-volume-high" aria-hidden="true"></i>
        </button>
        <a href="#quiz" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 bg-gold/20 border border-gold text-gold font-semibold rounded-lg hover:bg-gold hover:text-obsidian transition duration-300">
          <i class="fa-solid fa-gamepad" aria-hidden="true"></i> Quiz Budaya
        </a>
        <button id="menuBtn" class="lg:hidden w-10 h-10 rounded-full border border-gold/40 text-gold hover:bg-gold/10 transition" aria-expanded="false" aria-controls="menuMobile" aria-label="Buka menu">
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>

  <div id="menuMobile" class="lg:hidden hidden border-t border-gold/20 bg-obsidian/95">
    <div class="max-w-7xl mx-auto px-4 py-4 grid grid-cols-2 gap-2 text-sm">
      {
        tautan.map((t) => (
          <a href={t.href} data-nav class="px-4 py-3 rounded-xl border border-gold/20 hover:border-gold hover:text-gold transition">
            {t.label}
          </a>
        ))
      }
      <a href="#quiz" class="col-span-2 px-4 py-3 rounded-xl bg-gold/20 border border-gold text-gold font-semibold text-center">
        <i class="fa-solid fa-gamepad mr-2" aria-hidden="true"></i>Quiz Budaya
      </a>
    </div>
  </div>
</nav>

<script>
  import { aturSuara, suaraAktif } from '../scripts/audio';

  // Tombol suara
  const btnSuara = document.getElementById('soundToggleBtn')!;
  const ikon = document.getElementById('soundIcon')!;
  btnSuara.addEventListener('click', () => {
    const aktif = !suaraAktif();
    aturSuara(aktif);
    ikon.className = aktif ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark text-red-400';
    btnSuara.setAttribute('aria-pressed', String(aktif));
    btnSuara.setAttribute('aria-label', aktif ? 'Matikan suara' : 'Nyalakan suara');
  });

  // Menu mobile
  const menuBtn = document.getElementById('menuBtn')!;
  const menu = document.getElementById('menuMobile')!;
  const tutupMenu = () => {
    menu.classList.add('hidden');
    menuBtn.setAttribute('aria-expanded', 'false');
  };
  menuBtn.addEventListener('click', () => {
    const buka = menu.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(buka));
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', tutupMenu));

  // Bar progres scroll
  const bar = document.getElementById('progresScroll')!;
  let antre = false;
  const perbaruiProgres = () => {
    const maks = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${maks > 0 ? scrollY / maks : 0})`;
    antre = false;
  };
  addEventListener(
    'scroll',
    () => {
      if (!antre) {
        antre = true;
        requestAnimationFrame(perbaruiProgres);
      }
    },
    { passive: true },
  );

  // Sorot menu sesuai section yang terlihat
  const link = [...document.querySelectorAll<HTMLAnchorElement>('a[data-nav]')];
  const pengamat = new IntersectionObserver(
    (entri) => {
      for (const e of entri) {
        if (!e.isIntersecting) continue;
        for (const a of link) {
          const cocok = a.getAttribute('href') === `#${e.target.id}`;
          a.classList.toggle('text-gold', cocok);
          if (cocok) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((s) => pengamat.observe(s));
</script>
